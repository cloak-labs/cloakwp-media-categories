{
  "name": "cloakwp/media-categories",
  "description": "Core-like media categories for WordPress — PHP-configured, no settings UI.",
  "license": "LGPL-3.0-only",
  "type": "wordpress-muplugin",
  "authors": [
    {
      "name": "Kaelan Smith",
      "email": "kaelan@cloaklabs.co",
      "homepage": "https://github.com/kaelansmith"
    }
  ],
  "require": {
    "php": ">=8.2",
    "cloakwp/core": "dev-main",
    "composer/installers": "^1.0 || ^2.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0 || ^12.0"
  },
  "autoload": {
    "psr-4": {
      "CloakWP\\MediaCategories\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "CloakWP\\MediaCategories\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "composer/installers": true
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
